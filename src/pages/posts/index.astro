---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => b - a);
---

<Base title="全部文章" description="按时间倒序排列的全部文章。">
  <section class="posts">
    <div class="wrap">
      {years.map((year) => (
        <>
          <h2 style="margin-top:40px">{year}</h2>
          {posts.filter((p) => p.data.date.getFullYear() === year).map((post) => (
            <article class="post-item">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              <div>
                <h3><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h3>
                {post.data.summary && <p>{post.data.summary}</p>}
                {post.data.tags.length > 0 && (
                  <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
                )}
              </div>
            </article>
          ))}
        </>
      ))}
    </div>
  </section>
</Base>
