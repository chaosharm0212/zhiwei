---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Base title="知微" description="一个人维护的独立博客。没有广告，没有推荐位，只有文章。">
  <section class="hero">
    <div class="wrap">
      <h1>记录技术与思考。</h1>
      <p>一个人维护的独立博客。没有广告，没有推荐位，只有文章。写着写着，就成了自己的档案。</p>
    </div>
  </section>

  <section class="posts">
    <div class="wrap">
      <h2>全部文章 · {posts.length}</h2>
      {posts.map((post) => (
        <article class="post-item">
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <div>
            <h3><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h3>
            {post.data.summary && <p>{post.data.summary}</p>}
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
